# Site and target channels
TARGET_STREAM_URL=https://streamninja.cloud/
TARGET_CHANNELS=ESPN NZ,ESPN 2 NZ,SKY SPORT 1 NZ,SKY SPORT 2 NZ,SKY SPORT 3 NZ,SKY SPORT 4 NZ,SKY SPORT 5 NZ,SKY SPORT 6 NZ,SKY SPORT 7 NZ,SKY SPORT PREMIER LEAGUE NZ,SKY SPORT 9 NZ,SKY SPORT SELECT NZ

# Browser
BROWSER_CHANNEL=chrome
HEADLESS=false
PLAYER_MODE=default
FAIL_ON_UNHEALTHY=false

# Optional authentication and request configuration
PLAYWRIGHT_STORAGE_STATE_BASE64=
EXTRA_HTTP_HEADERS_JSON=

# Optional JSON report delivery.
HEALTH_REPORT_ENDPOINT=
HEALTH_REPORT_TOKEN=
HEALTH_REPORT_PATH=artifacts/channel-health.json

# Timing and crawl limits (milliseconds except counts)
NAVIGATION_TIMEOUT_MS=60000
CHANNEL_TIMEOUT_MS=90000
SOURCE_SETTLE_MS=1000
PLAY_FALLBACK_ENABLED=false
PLAY_FALLBACK_DELAY_MS=30000
DISCOVERY_SCROLL_DELAY_MS=500
DISCOVERY_STABLE_PASSES=3
DISCOVERY_MAX_PASSES=40
DISCOVERY_RETRIES=3
MAX_CARDS=200
POST_TIMEOUT_MS=30000

# Playlist (m3u8) capture worker
# PLAYLIST_TARGETS is a JSON array of {slug,url}. The slug must match a channel slug
# in your backend (so the report updates the right channel); the url is the iframe
# player page the worker should open in the browser.

# Key extraction (optional, opt-in). When EXTRACT_KEYS=true the monitor MITMs the
# EME exchange with your LOCAL Widevine .wvd device to recover the content keys
# (kid + key value), the same mechanism the browser extension uses. This re-signs
# the license challenge, so the headless browser's own playback will usually not
# decrypt -- the goal is key capture, not healthy playback. Requires WIDEVINE_DEVICE_B64.
# Generate it with:  base64 -w0 "path/to/device.wvd"
# In CI store it as a secret (e.g. WIDEVINE_DEVICE_B64) and map it to the env var.
EXTRACT_KEYS=false
WIDEVINE_DEVICE_B64=
# PSSH is recovered from the license-challenge init data, so the manifest body is
# never captured or reported. No separate flag is needed.
PLAYLIST_TARGETS=[{"slug":"bbc-one","url":"https://cdnlivetv.tv/api/v1/channels/player/?name=BBC%20One&code=gb&user=cdnlivetv&plan=free"}]
PLAYLIST_MAX_RETRIES=20
PLAYLIST_CAPTURE_TIMEOUT_MS=30000
